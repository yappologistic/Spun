# Publish only the project source and explicitly approved assets.
# New top-level directories or file types must be added here deliberately.
/*
!/.gitignore
!/CMakeLists.txt
!/README.md
!/LICENSE
!/NOTICE

!/src/
/src/*
!/src/*.cpp
!/src/*.h

!/qml/
/qml/*
!/qml/*.qml

!/scripts/
/scripts/*
!/scripts/*.sh
!/scripts/*.py

!/licenses/
/licenses/*
!/licenses/*.txt

!/assets/
/assets/*
!/assets/spun-icon.png
!/assets/spun-window.png
!/assets/First-Light.flac
!/assets/screenshots/
/assets/screenshots/*
!/assets/screenshots/spun-vinyl.png
!/assets/icons/
/assets/icons/*
!/assets/icons/*.svg
!flake.nix

# Never publish credentials, private state, editor backups or generated caches.
.env*
*.ini
*.user
*.log
*.key
*.pem
*~
*.bak
__pycache__/
cider-connection.json
listening.json
